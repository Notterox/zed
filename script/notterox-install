#!/usr/bin/env bash
# NOTTEROX: build this fork in release mode and install it with the official Windows layout:
#
#   <dest>/Zed.exe            the editor
#   <dest>/bin/zed.exe        the CLI (finds ../Zed.exe, forwards to a running instance)
#   <dest>/conpty.dll, <dest>/amd_ags_x64.dll, <dest>/{x64,arm64}/OpenConsole.exe
#                             third-party binaries from the official installer; kept if
#                             already installed, else copied from $ZED_STOCK_DIR (FORK.md)
#
# Installing to a separate folder keeps the running editor from locking target/release.
#
# Usage (Git Bash): script/notterox-install [dest]
#   dest            install folder (default $ZED_FORK_DIR, else C:/Home/Soft/ZedFork)
#   ZED_STOCK_DIR   official Zed install or unpacked installer to copy missing DLLs from

set -euo pipefail

dest="${1:-${ZED_FORK_DIR:-/c/Home/Soft/ZedFork}}"
stock="${ZED_STOCK_DIR:-}"
cmake_bin="/c/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin"

cd "$(dirname "$0")/.."
[ -d "$cmake_bin" ] && export PATH="$cmake_bin:$PATH"
# RUSTFLAGS would override .cargo/config.toml (see docs/src/development/windows.md).
unset RUSTFLAGS

cargo build --release --package zed --package cli

mkdir -p "$dest/bin"
if ! cp target/release/zed.exe "$dest/Zed.exe"; then
    echo "error: could not replace $dest/Zed.exe; close the Zed running from there and retry" >&2
    exit 1
fi
cp target/release/cli.exe "$dest/bin/zed.exe"
for file in conpty.dll amd_ags_x64.dll x64/OpenConsole.exe arm64/OpenConsole.exe; do
    if [ -f "$dest/$file" ]; then
        continue
    elif [ -n "$stock" ] && [ -f "$stock/$file" ]; then
        mkdir -p "$(dirname "$dest/$file")"
        cp "$stock/$file" "$dest/$file"
    else
        echo "warning: $dest/$file is missing; see FORK.md, Building and installing" >&2
    fi
done
git describe --tags --always --dirty > "$dest/VERSION"

echo "Installed $(cat "$dest/VERSION") to $dest"
